# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#	<file system>														<mount point>				<type>	<options>																					<dump>	<pass>

# / was on /dev/nvme0n1p5 during installation
UUID=ab271b8f-878d-4437-8605-45411e0b6eb0	/										ext4		noatime,errors=remount-ro													0				0		#/dev/nvme0n1p5
                                                                                                                          			
# /boot/efi was on /dev/nvme0n1p1 during installation                                                                     			
UUID=313C-E603														/boot/efi						vfat		umask=0077																				0				1		#/dev/nvme0n1p1
                                                                                                                          			
8560w.local:/home/mdzzg										/mnt/nfs/8560w			nfs			auto,nofail,noatime,nolock,intr,tcp,actimeo=1800	0				0
#8560w.local:/mnt/nfs/1.8twdg							/mnt/nfs/1.8twdg		nfs			auto,nofail,noatime,nolock,intr,tcp,actimeo=1800	0				0
8560w.local:/mnt/nfs/931.5gwdb						/mnt/nfs/931.5gwdb	nfs			auto,nofail,noatime,nolock,intr,tcp,actimeo=1800	0				0
8560w.local:/mnt/nfs/465.8gwdcg						/mnt/nfs/465.8gwdcg	nfs			auto,nofail,noatime,nolock,intr,tcp,actimeo=1800	0				0
8560w.local:/mnt/nfs/298.1gsb							/mnt/nfs/298.1gsb		nfs			auto,nofail,noatime,nolock,intr,tcp,actimeo=1800	0				0
8560w.local:/mnt/nfs/149.1gsb							/mnt/nfs/149.1gsb		nfs			auto,nofail,noatime,nolock,intr,tcp,actimeo=1800	0				0

